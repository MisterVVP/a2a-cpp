@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(A2A_CPP_HAS_AGENT_CARD_SIGNING "@A2A_ENABLE_SIGNING@")
if(A2A_CPP_HAS_AGENT_CARD_SIGNING)
  find_dependency(OpenSSL 3.0)
endif()

find_dependency(simdjson @simdjson_VERSION@ CONFIG)
find_dependency(gRPC CONFIG)
if(NOT TARGET protobuf::libprotobuf)
  find_dependency(Protobuf)
endif()

set(A2A_CPP_HAS_LIBCURL "@A2A_HAS_LIBCURL@")
if(A2A_CPP_HAS_LIBCURL)
  find_dependency(CURL)
endif()

set(A2A_CPP_HAS_POSTGRES_STORE "@A2A_ENABLE_POSTGRES_STORE@")
if(A2A_CPP_HAS_POSTGRES_STORE)
  find_dependency(PostgreSQL)
endif()

set(A2A_CPP_HAS_ASIO "@A2A_ENABLE_ASIO@")
if(A2A_CPP_HAS_ASIO)
  find_dependency(Boost @A2A_BOOST_VERSION@ CONFIG)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/a2a_cppTargets.cmake")
